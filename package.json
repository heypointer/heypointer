{
  "name": "heypointer",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heypointer/heypointer.git"
  },
  "workspaces": [
    "packages/*",
    "samples/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "ci": "npm run build && npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/vite": "^4.3.5"
  }
}
