{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src", "outDir": "dist", "jsx": "react-jsx", "sourceMap": true, "declarationMap": true,
    // The SDK is type-checked from source here (so build order does not matter); its source imports ?inline CSS.
    "customConditions": ["source"], "types": ["vite/client"]
  },
  "include": ["src"]
}
